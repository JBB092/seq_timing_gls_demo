# Simulation revision (revision "core_sim", top = core)
# Same core as the board, without the PLL and the displays, so the testbench
# sets the clock period. Used by approach B: Quartus writes a functional
# netlist of core for each depth.
# CHAIN_DEPTH is not set here: scripts/build.tcl passes it as VERILOG_MACRO

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSXFC6D6F31C6
set_global_assignment -name TOP_LEVEL_ENTITY core
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# Sources
set_global_assignment -name SEARCH_PATH ../rtl
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/dff_stage_rtl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/lfsr.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/chain_stage_rtl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/delay_chain.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/ref_path.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/error_checker.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/core.sv
set_global_assignment -name SDC_FILE core_sim.sdc

# Clock on the same pin as CLOCK_50 on the board
set_location_assignment PIN_AF14 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk

# The other ports only exist for the testbench: virtual pins, no I/O cells
set_instance_assignment -name VIRTUAL_PIN ON -to rst
set_instance_assignment -name VIRTUAL_PIN ON -to clr
set_instance_assignment -name VIRTUAL_PIN ON -to chain_q
set_instance_assignment -name VIRTUAL_PIN ON -to ref_q
set_instance_assignment -name VIRTUAL_PIN ON -to err_count[*]
set_instance_assignment -name VIRTUAL_PIN ON -to err_flag

# Functional netlist for Questa (Cyclone V has no timing netlist)
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Intel FPGA (SystemVerilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "SYSTEMVERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST ON -section_id eda_simulation
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
